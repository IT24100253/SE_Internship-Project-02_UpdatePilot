generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. පරිශීලකයන් (Users)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  devices   Device[]
}

// 2. Devices
model Device {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  osVersion    String?
  agentVersion String?
  status       String            @default("OFFLINE")
  lastSeen     DateTime?
  createdAt    DateTime          @default(now())
  credentials  AgentCredential[]
  applications Application[]
  scanJobs     ScanJob[]
  updateJobs   UpdateJob[]
  auditEvents  AuditEvent[]
}

// 3. Agent Credentials
model AgentCredential {
  id        String    @id @default(uuid())
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  isRevoked Boolean   @default(false)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

// 4. Installed Applications
model Application {
  id               String      @id @default(uuid())
  deviceId         String
  device           Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  displayName      String
  publisher        String?
  installedVersion String
  availableVersion String?
  packageId        String?
  source           String      @default("winget")
  status           String      @default("UP_TO_DATE")
  lastScannedAt    DateTime    @default(now())
  updateJobs       UpdateJob[]

  @@unique([deviceId, displayName, packageId])
}

// 5. Scan Jobs
model ScanJob {
  id           String    @id @default(uuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  state        String    @default("PENDING")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  appsFound    Int       @default(0)
  updatesFound Int       @default(0)
  errorSummary String?
}

// 6. Update Jobs
model UpdateJob {
  id                 String      @id @default(uuid())
  deviceId           String
  device             Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  applicationId      String
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousVersion    String
  targetVersion      String
  state              String      @default("PENDING")
  exitCode           Int?
  verificationResult String?
  errorSummary       String?
  createdAt          DateTime    @default(now())
  completedAt        DateTime?
}

// 7. Audit Events
model AuditEvent {
  id        String   @id @default(uuid())
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  actor     String
  eventType String
  target    String?
  details   String?
  createdAt DateTime @default(now())
}